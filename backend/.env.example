# --- Core ---
DATABASE_URL=sqlite:///data/rentagent.db          # prod: postgresql+psycopg://rent:rent@localhost:5432/rentagent
CHECKPOINT_URL=sqlite:///data/checkpoints.db       # prod: postgresql://rent:rent@localhost:5432/rentagent
# REDIS_URL=redis://localhost:6379/0               # enables Celery workers + cross-process live events
ANTHROPIC_API_KEY=                                 # enables NL parsing, extraction, web-search discovery, message writing, agreement review
USER_NAME=Asha                                     # used in the AI disclosure: "writing on behalf of Asha"

# --- Discovery ---
ENABLE_WEB_SEARCH_DISCOVERY=true
DISCOVERY_INTERVAL_MINUTES=120
FETCH_ALLOWED_DOMAINS=                             # comma-separated; add a domain only after reviewing its terms of use
PLAYWRIGHT_ENABLED=false

# --- Email (your own / dedicated mailbox): sends enquiries, reads replies + portal alert emails ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_ALERT_FOLDER=INBOX
IMAP_REPLY_FOLDER=INBOX

# --- WhatsApp Cloud API (official). Cold first contact stays "assisted" unless you have opt-in + an approved template ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=rentagent-verify
WHATSAPP_FIRST_CONTACT_TEMPLATE=

# --- Your notifications ---
USER_EMAIL=
USER_WHATSAPP=

# --- Safety rails ---
DAILY_OUTREACH_CAP=10
CONTACT_COOLDOWN_HOURS=48
MIN_SCORE_TO_CONTACT=60
AUTO_FOLLOWUPS=true          # info-only follow-ups in an existing thread
AUTO_VISIT_SLOTS=true        # proposing free calendar slots
CORS_ORIGINS=http://localhost:3000
